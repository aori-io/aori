{
  "name": "aori",
  "version": "0.3.1",
  "private": true,
  "license": "MIT",
  "scripts": {
    "clean": "rm -rf artifacts cache out",
    "compile": "forge build",
    "lint": "$npm_execpath run lint:js && $npm_execpath run lint:sol",
    "lint:fix": "eslint --fix '**/*.{js,ts,json}' && prettier --write . && solhint 'contracts/**/*.sol' --fix --noPrompt",
    "lint:js": "eslint '**/*.{js,ts,json}' && prettier --check .",
    "lint:sol": "solhint 'contracts/**/*.sol'",
    "test": "forge test",
    "deploy:testnet": "./deploy/deploy.sh testnet --broadcast",
    "deploy:testnet:dry": "./deploy/deploy.sh testnet",
    "deploy:testnet:peers": "./deploy/deploy.sh testnet --configure-peers",
    "deploy:testnet:full": "./deploy/deploy.sh testnet --full",
    "deploy:mainnet": "./deploy/deploy.sh mainnet --broadcast",
    "deploy:mainnet:dry": "./deploy/deploy.sh mainnet",
    "deploy:mainnet:peers": "./deploy/deploy.sh mainnet --configure-peers",
    "deploy:mainnet:full": "./deploy/deploy.sh mainnet --full",
    "upgrade:testnet": "./deploy/deploy.sh testnet --upgrade --broadcast",
    "upgrade:testnet:dry": "./deploy/deploy.sh testnet --upgrade",
    "upgrade:mainnet": "./deploy/deploy.sh mainnet --upgrade --broadcast",
    "upgrade:mainnet:dry": "./deploy/deploy.sh mainnet --upgrade",
    "verify": "forge script script/DeployMultichain.s.sol:VerifyDeployments"
  },
  "resolutions": {
    "ethers": "^5.7.2"
  },
  "devDependencies": {
    "@babel/core": "^7.23.9",
    "@layerzerolabs/eslint-config-next": "~2.3.39",
    "@layerzerolabs/lz-definitions": "^3.0.59",
    "@layerzerolabs/lz-evm-messagelib-v2": "^3.0.12",
    "@layerzerolabs/lz-evm-protocol-v2": "^3.0.12",
    "@layerzerolabs/lz-evm-v1-0.7": "^3.0.12",
    "@layerzerolabs/lz-v2-utilities": "^3.0.12",
    "@layerzerolabs/oapp-evm": "^0.3.0",
    "@layerzerolabs/oapp-evm-upgradeable": "^0.1.3",
    "@layerzerolabs/prettier-config-next": "^2.3.39",
    "@layerzerolabs/solhint-config": "^3.0.12",
    "@layerzerolabs/test-devtools-evm-foundry": "~6.0.0",
    "@layerzerolabs/toolbox-foundry": "~0.1.9",
    "@layerzerolabs/toolbox-hardhat": "^0.6.13",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@openzeppelin/contracts": "^5.0.2",
    "@openzeppelin/contracts-upgradeable": "^5.0.2",
    "@rushstack/eslint-patch": "^1.7.0",
    "@types/node": "~18.18.14",
    "concurrently": "~9.1.0",
    "dotenv": "^16.4.7",
    "eslint": "^9.0.0",
    "eslint-plugin-jest-extended": "~2.0.0",
    "ethers": "^5.8.0",
    "hardhat": "^2.28.3",
    "prettier": "^3.2.5",
    "solady": "^0.1.12",
    "solhint": "^4.1.1",
    "solidity-bytes-utils": "^0.8.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.4"
  },
  "engines": {
    "node": ">=18.16.0"
  },
  "pnpm": {
    "overrides": {
      "ethers": "^5.7.2"
    }
  },
  "overrides": {
    "ethers": "^5.7.2"
  },
