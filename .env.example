#   .-.-.   .-.-.   .-.-.   .-.-.   .-.-.   .-.-.   .-.-.   .-.-
#  / / \ \ / / \ \ / / \ \ / / \ \ / / \ \ / / \ \ / / \ \ / / \
# `-'   `-`-'   `-`-'   `-`-'   `-`-'   `-`-'   `-`-'   `-`-'
#
#               Example environment configuration
#
#   .-.-.   .-.-.   .-.-.   .-.-.   .-.-.   .-.-.   .-.-.   .-.-
#  / / \ \ / / \ \ / / \ \ / / \ \ / / \ \ / / \ \ / / \ \ / / \
# `-'   `-`-'   `-`-'   `-`-'   `-`-'   `-`-'   `-`-'   `-`-'

# =============================================================================
# CONTRACTS
# =============================================================================
AORI_PROXY_ADDRESS=0x...

# =============================================================================
# DEPLOYER
# =============================================================================

# By default, the examples support both mnemonic-based and private key-based authentication
# You don't need to set both of these values, just pick the one that you prefer and set that one
MNEMONIC=YOUR_MNEMONIC

# Contract owner's private key
# This is used for deployment and signing whitelist transactions
# Warning: Keep this secure and never commit to version control
PRIVATE_KEY=YOUR_PRIVATE_KEY

# =============================================================================
# DEPLOYMENT CONFIGURATION
# =============================================================================

# Contract owner address (should be multisig for mainnet)
OWNER_ADDRESS=0x...

# CREATE3 deployment salt - same salt = same address on all chains
DEPLOY_SALT=aori-v1

# Max orders per settlement batch (default: 200)
MAX_FILLS_PER_SETTLE=200

# Deployed proxy address (required for peer config and upgrades)
AORI_PROXY_ADDRESS=0x...

# Optional: Initial configuration (comma-separated)
INITIAL_SOLVERS=0x...,0x...
INITIAL_HOOKS=0x...,0x...

# =============================================================================
# MAINNET RPC URLS
# =============================================================================
ETHEREUM_RPC_URL=YOUR_URL
BASE_RPC_URL=YOUR_URL
OPTIMISM_RPC_URL=YOUR_URL
ARBITRUM_RPC_URL=YOUR_URL
BSC_RPC_URL=YOUR_URL
PLASMA_RPC_URL=YOUR_URL
MONAD_RPC_URL=YOUR_URL
STABLE_RPC_URL=YOUR_URL

# =============================================================================
# TESTNET RPC URLS
# =============================================================================

SEPOLIA_RPC_URL=YOUR_URL
BASE_SEPOLIA_RPC_URL=YOUR_URL
ARBITRUM_SEPOLIA_RPC_URL=YOUR_URL
OPTIMISM_SEPOLIA_RPC_URL=YOUR_URL

# =============================================================================
# MAINNET BLOCK EXPLORER API KEYS (for contract verification)
# =============================================================================
ETHERSCAN_API_KEY=YOUR_KEY
BASESCAN_API_KEY=YOUR_KEY
ARBISCAN_API_KEY=YOUR_KEY
OPTIMISM_ETHERSCAN_API_KEY=YOUR_KEY
BSCSCAN_API_KEY=YOUR_KEY
PLASMASCAN_API_KEY=YOUR_KEY
MONAD_EXPLORER_API_KEY=YOUR_KEY
STABLE_EXPLORER_API_KEY=YOUR_KEY

# =============================================================================
# TESTNET BLOCK EXPLORER API KEYS (for contract verification)
# =============================================================================
SEPOLIA_ETHERSCAN_API_KEY=YOUR_KEY
BASE_SEPOLIA_ETHERSCAN_API_KEY=YOUR_KEY
ARBISCAN_SEPOLIA_API_KEY=YOUR_KEY
OPTIMISM_SEPOLIA_ETHERSCAN_API_KEY=YOUR_KEY

# =============================================================================
# TENDERLY (optional)
# =============================================================================

TENDERLY_PROJECT=your_tenderly_project_name
TENDERLY_USERNAME=your_tenderly_username
# Block Explorer API Keys (for contract verification)
ETHERSCAN_API_KEY=
BASESCAN_API_KEY=
OPTIMISM_ETHERSCAN_API_KEY=
ARBISCAN_API_KEY=
BSCSCAN_API_KEY=

# =============================================================================
# SOLANA CONFIGURATION
# =============================================================================

# Solana Wallet (choose one method)
# Option 1: Private key as base58 string or Uint8 Array string format (e.g. [1,2,3...])
SOLANA_PRIVATE_KEY=

# Option 2: Path to keypair file (defaults to ~/.config/solana/id.json if not set)
SOLANA_KEYPAIR_PATH=

# Solana RPC URLs
RPC_URL_SOLANA=
RPC_URL_SOLANA_TESTNET=
